<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Membership Plans"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose the perfect plan for your fitness journey"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorSecondary"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="28dp" />

        <!-- Monthly Plan -->

        <!-- Monthly Plan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONTHLY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6B4FB3"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹999"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per Month"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btnMonthly"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SELECT PLAN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#6B4FB3" />

        </LinearLayout>

        <!-- Quarterly Plan -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUARTERLY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6B4FB3"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹2499"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="For 3 Months"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btnQuarterly"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SELECT PLAN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#6B4FB3" />

        </LinearLayout>

        <!-- Yearly Plan -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@android:drawable/dialog_holo_light_frame">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YEARLY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#6B4FB3"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹7999"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per Year"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btnYearly"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SELECT PLAN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#6B4FB3" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>